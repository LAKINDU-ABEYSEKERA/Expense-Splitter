{
  "compilerOptions": {
    "target":"es2022",
    "module": "nodenext",
    "moduleResolution":"nodenext",
    "rootDir": "./src",
    "outDir":"./dist",

    "strict": true,
    "noUncheckedIndexedAccess":true,
    "esModuleInterop":true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax":true,
    "isolatedModules": true,

    "types":["node"],
    "sourceMap": true
  },
  "include": ["src/**/*"]
}